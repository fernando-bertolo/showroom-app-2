# URL base da API do CarStock (Spring). Usada SOMENTE no servidor Next
# (server components, route handlers e middleware) — não vaza para o browser.
# Dev:  http://localhost:8080/api/v1
# Prod: https://api.byeauto.com.br/api/v1
API_BASE_URL=http://localhost:8080/api/v1

# Slug da loja usado como fallback quando o host não é um subdomínio
# de vitrine (ex.: acesso direto via localhost:3001 em desenvolvimento).
DEFAULT_BRANCH_SLUG=carstock-sp

# Domínio raiz das vitrines multi-tenant. O middleware extrai o slug de
# hosts no formato {slug}.{ROOT_DOMAIN} (e também {slug}.localhost em dev).
# Subdomínios reservados: www, api, app, site.
NEXT_PUBLIC_SHOWROOM_ROOT_DOMAIN=byeauto.com.br
